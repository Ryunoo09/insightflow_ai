# Copy to .env and fill locally. Never commit real secrets.

# Go API
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8080

# Python Engine (internal loopback only)
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8000
ENGINE_URL=http://127.0.0.1:8000
ENGINE_INTERNAL_TOKEN=change-me-internal-ipc-token
# DuckDB profiling watchdog: abort a run that exceeds this many seconds.
PROFILE_TIMEOUT_SECONDS=30

# PostgreSQL (Plan 02)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/insightflow_dev?sslmode=disable

# Redis / Memurai (Plan 02)
REDIS_URL=redis://localhost:6379/0

# Auth (Plan 03) - min 32 bytes
JWT_SECRET=change-me-min-32-byte-random-string
JWT_ISSUER=insightflow
JWT_AUDIENCE=insightflow-web
# OTP challenge HMAC secret (min 16 bytes) - min 16 bytes
OTP_SECRET=change-me-otp-hmac-secret
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# Browser origins allowed to call cookie-auth routes (comma separated)
ALLOWED_ORIGINS=http://localhost:5173
WEB_BASE_URL=http://localhost:5173

# LLM provider (Plan 06)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Google OAuth (Plan 03)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# SMTP (dev: Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@insightflow.local
# Leave empty for Mailpit in dev; required for authenticated relays.
SMTP_USERNAME=
SMTP_PASSWORD=

# Storage (Plan 04) - dataset sources and Parquet files. The Go API and the
# Python Engine must resolve this to the same directory. Use an absolute path so
# it does not depend on each process's working directory.
STORAGE_ROOT=storage

# Dataset upload / processing limits (Plan 04, PRD 27.4)
LIMIT_MAX_CSV_BYTES=52428800
LIMIT_MAX_XLSX_BYTES=20971520
LIMIT_MAX_ROWS_CSV=1000000
LIMIT_MAX_ROWS_XLSX=200000
LIMIT_MAX_COLUMNS=200
LIMIT_MAX_DATASETS=20

# Dataset lifecycle & queue hardening (Plan 11)
# Requeues/fails jobs stuck in 'processing' past this window. Must exceed the
# engine timeout (300s).
JOB_STALE_AFTER=10m
# Soft-deleted datasets are physically purged after this many days.
DATASET_PURGE_GRACE_DAYS=7

